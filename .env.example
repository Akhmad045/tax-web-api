# ==========================================================================
# Konfigurasi Email (SMTP) untuk verifikasi OTP registrasi
# ==========================================================================
# Salin file ini menjadi `.env` lalu isi nilainya.
#
# Untuk Gmail, JANGAN pakai password akun. Google memblokir login SMTP
# dengan password biasa. Buat "App Password":
#   1. Aktifkan Verifikasi 2 Langkah pada akun Google.
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat app password (16 karakter), lalu tempel ke MAIL_PASSWORD.
#
# Bila variabel ini dibiarkan kosong, kode OTP TIDAK dikirim lewat email,
# tetapi dicetak ke log server dengan prefix [OTP-DEV] agar alur registrasi
# tetap bisa diuji di lokal.

MAIL_USERNAME=alamat.email@gmail.com
MAIL_PASSWORD=app-password-16-karakter
MAIL_FROM=alamat.email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ==========================================================================
# Opsional
# ==========================================================================

# Masa berlaku kode OTP dalam menit (default 5).
#OTP_TTL_MINUTES=5
