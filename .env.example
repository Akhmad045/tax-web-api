# ==========================================================================
# Konfigurasi Email (HTTP API Brevo) untuk verifikasi OTP registrasi
# ==========================================================================
# Salin file ini menjadi `.env` lalu isi nilainya.
#
# Pengiriman email memakai HTTP API Brevo, BUKAN SMTP: port SMTP (25/465/587)
# diblokir di hosting gratis seperti Render, sedangkan HTTPS (443) selalu
# terbuka.
#
# Langkah mendapatkan nilainya:
#   1. Daftar/gratis di https://app.brevo.com
#   2. Menu "Senders, Domains & Dedicated IPs" -> tambahkan dan VERIFIKASI
#      alamat pengirim (biasanya alamat Gmail sendiri).
#   3. Menu "SMTP & API" -> tab "API Keys" -> buat kunci baru.
#
# Bila BREVO_API_KEY dibiarkan kosong, kode OTP TIDAK dikirim lewat email,
# tetapi dicetak ke log server dengan prefix [OTP-DEV] agar alur registrasi
# tetap bisa diuji di lokal.

BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Harus alamat yang sudah diverifikasi sebagai sender di Brevo.
BREVO_SENDER=alamat.email@gmail.com
# Opsional, default "Tim 3 Kalkulator Pajak".
#BREVO_SENDER_NAME=Tim 3 Kalkulator Pajak

# ==========================================================================
# Opsional
# ==========================================================================

# Masa berlaku kode OTP dalam menit (default 5).
#OTP_TTL_MINUTES=5


# ==========================================================================
# Database permanen (produksi): PostgreSQL gratis
# ==========================================================================
# Bila variabel ini DIISI, database.py memakai PostgreSQL (bukan SQLite
# lokal yang hilang tiap restart Render). Bila dikosongkan/dihapus, backend
# kembali ke SQLite lokal (hanya untuk pengembangan/pengujian).
#
# Cara mendapatkan URL-nya (pilih satu):
#   - Supabase (gratis): buat project -> Project Settings -> Database ->
#     Connection string -> URI. Pakai string "Session pooler" (port 5432)
#     atau direct connection, BUKAN "Transaction pooler" (port 6543).
#   - Neon (gratis): buat project -> dashboard -> Connection string.
# Tempel URL lengkapnya (sudah berisi username, password, host, database)
# ke Environment Variable Render dengan nama DATABASE_URL, lalu redeploy.
# Kode otomatis menambahkan sslmode=require bila belum ada di URL.
#
#DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@db.xxxxx.supabase.co:5432/postgres
